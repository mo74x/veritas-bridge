    "@veritas/contracts": "workspace:*",
    "@veritas/extraction-agent": "workspace:*",
    "bullmq": "^5.15.0",
    "dotenv": "^18.0.10",
    "ioredis": "^5.4.1",
    "pg": "^8.23.1",
