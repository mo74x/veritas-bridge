generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SyncStatus {
  SYNCED
  QUARANTINED_LOW_CONFIDENCE
  QUARANTINED_SCHEMA_FAILURE
  FAILED_DOWNSTREAM_API
  ROLLED_BACK
}

enum ActorType {
  DETERMINISTIC_FAST_PATH
  AI_EXTRACTION_AGENT
  HUMAN_QUARANTINE_OVERRIDE
  SYSTEM_ROLLBACK
}

model SyncAuditLedger {
  id                String     @id @default(uuid())
  idempotencyKey    String     @unique
  sourceSystem      String
  sourceRecordId    String
  targetSystem      String
  targetRecordId    String?
  status            SyncStatus
  actor             ActorType
  rawInputPayload   Json
  normalizedPayload Json?
  beforeState       Json?
  afterState        Json?
  modelVersion      String
  promptHash        String
  confidenceScore   Float
  ambiguityFlags    Json
  latencyMs         Int
  previousHash      String
  currentHash       String            @unique
  parentAuditId     String?
  parentAudit       SyncAuditLedger?  @relation("AuditResolution", fields: [parentAuditId], references: [id])
  childAudits       SyncAuditLedger[] @relation("AuditResolution")
  createdAt         DateTime          @default(now())

  @@index([sourceRecordId, status])
  @@index([status, createdAt])
  @@index([parentAuditId])
}